# Maintainer: William C. Canin
pkgname=argvus-wallpapers
pkgver=0.1.0
pkgrel=1
pkgdesc="ARGVUS desktop wallpapers for the default theme set."
arch=('any')
url="https://github.com/argvus/argvus-wallpapers"
license=('GPL-3.0-only')
depends=()
makedepends=()
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" PREFIX=/usr install
}