pkgname=argvus-wallpapers
pkgver=0.1.0
pkgrel=1
pkgdesc="ARGVUS desktop wallpapers for the default theme set."
arch=('any')
url=""
license=('GPL-3.0-only')
depends=()
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_wallpapers_payload
}

package() {
  arch_package_wallpapers_payload
}
